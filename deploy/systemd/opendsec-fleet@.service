# One fleet replica (cluster management, spec §28): systemctl enable --now opendsec-fleet@0
# (instance = replica id in fleet.replicas). Releases are kept in its data_dir.
[Unit]
Description=OpenDsec fleet %i
After=network-online.target
Wants=network-online.target

[Service]
User=opendsec
Group=opendsec
ExecStart=/usr/local/bin/opendsec-fleet -config /etc/opendsec/opendsec.json -replica %i -metrics :9465
Restart=always
RestartSec=1
StateDirectory=opendsec/fleet
StateDirectoryMode=0750
LimitNOFILE=1048576
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/etc/opendsec

[Install]
WantedBy=multi-user.target
