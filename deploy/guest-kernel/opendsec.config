# OpenDsec additions to Firecracker's 6.1 CI guest config (SPEC §19.13).
# Compressed swap in the guest: DAMON pages cold anonymous memory out to it.
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZO=y
# Boot time: the crypto self-tests at boot take ~80 ms.
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y
# The running config, for checks.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOCALVERSION="-opendsec"
# EROFS image disks (SPEC §29.4): an image is built once in the store as a
# read-only EROFS disk; uncompressed, so it can still be mapped with DAX.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
